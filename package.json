{
  "name": "job-hive",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered MERN Job Portal with multiple free job API integrations",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "prebuild": "node -e \"if(process.platform==='linux'){try{require('child_process').execSync('npm install --no-save @rollup/rollup-linux-x64-gnu',{stdio:'inherit'})}catch(e){}}\"",
    "postinstall": "node -e \"if(process.platform==='linux'){try{require('child_process').execSync('npm install --no-save @rollup/rollup-linux-x64-gnu',{stdio:'inherit'})}catch(e){}}\"",
    "start": "npm run start -w backend",
    "seed": "npm run seed -w backend",
    "cron:fetch": "npm run cron:fetch -w backend"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4",
    "concurrently": "^9.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
