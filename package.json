{
  "name": "job-hive",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered MERN Job Portal with multiple free job API integrations",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n backend,frontend -c yellow,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "seed": "npm run seed -w backend",
    "cron:fetch": "npm run cron:fetch -w backend"
  },
  "overrides": {
    "vite": {
      "rollup": "npm:@rollup/wasm-node@^4.28.1"
    },
    "rollup": "npm:@rollup/wasm-node@^4.28.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
