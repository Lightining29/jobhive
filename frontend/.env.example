# Frontend Environment Variables Configuration
# Copy this file to .env or set environment variables in your hosting provider (Hostinger/Vercel/Netlify)

# Specify full URL to backend API when deploying backend separately:
# Example: VITE_API_URL=https://your-backend-api.hostingersite.com/api
VITE_API_URL=

# Optional: Specify socket URL if different from backend API URL:
# Example: VITE_SOCKET_URL=https://your-backend-api.hostingersite.com
VITE_SOCKET_URL=
