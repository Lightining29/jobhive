{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"if(process.platform==='linux'){try{require('child_process').execSync('npm install --no-save @rollup/rollup-linux-x64-gnu @rollup/rollup-linux-x64-musl',{stdio:'inherit'})}catch(e){}}\"",
    "build": "node -e \"if(process.platform==='linux'){try{require('child_process').execSync('npm install --no-save @rollup/rollup-linux-x64-gnu @rollup/rollup-linux-x64-musl',{stdio:'inherit'})}catch(e){}}\" && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.1",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.27.0",
    "socket.io-client": "^4.8.3",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.3",
    "@rollup/rollup-linux-x64-musl": "^4.62.3"
  }
}
