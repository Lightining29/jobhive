PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────────────
# Hostinger MySQL Database Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Set DB_DRIVER=mysql to use Hostinger MySQL
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_DIALECT=mysql
DB_SYNC=true

# MongoDB Fallback (set a local URI or use Docker `mongodb://localhost:27017/jobhive`)
MONGO_URI=mongodb://127.0.0.1:27017/jobhive

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth (for Google Login / Sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (resume / logo uploads) - optional, falls back to local file storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Brevo (formerly Sendinblue) REST API for Transactional OTP Emails (Recommended)
# ──────────────────────────────────────────────────────────────────────────────
# Get your API key from Brevo dashboard: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@jobhive.app
BREVO_SENDER_NAME=JobHive

# Email (SMTP) - optional fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Job Hive <no-reply@example.com>
# If set to true and no Brevo API key is set, emails are logged to console
MAIL_DEV=true

# Job APIs - fetching is OFF by default. To enable a provider, set its flag to true.
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
ADZUNA_ENABLED=false
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
ARBEITNOW_ENABLED=false
REMOTIVE_ENABLED=false
MUSE_ENABLED=false
# Himalayas + Jobicy are free and need no API key
HIMALAYAS_ENABLED=false
JOBICY_ENABLED=false
# Company career pages (Greenhouse ATS - free, no key)
GREENHOUSE_ENABLED=false
GREENHOUSE_COMPANIES=airbnb,reddit,stripe,cloudflare
# Amazon careers (free, no key)
AMAZON_ENABLED=false
# Ashby ATS career pages (free, no key)
ASHBY_ENABLED=false
ASHBY_COMPANIES=notion,linear

# ──────────────────────────────────────────────────────────────────────────────
# AI LLM Provider — Google Gemini API (Recommended for Chatbox, Resume & Portfolio)
# ──────────────────────────────────────────────────────────────────────────────
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
# When GEMINI_API_KEY is set, Gemini API is used automatically as top priority provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OPTION 2: Qwen API (cloud fallback)
QWEN_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_MODEL=qwen-plus

# OPTION 2: Ollama (self-hosted, runs locally — free)
# Install Ollama from https://ollama.ai then run: ollama pull qwen3:8b
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_FALLBACK_MODEL=qwen3:4b

# Shared LLM settings (apply to both providers)
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_TIMEOUT=30000

# Embeddings (uses Ollama — local only, no cloud option needed)
# Run: ollama pull nomic-embed-text
EMBEDDING_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT=10000

# ──────────────────────────────────────────────────────────────────────────────
# Kokoro TTS (self-hosted, OpenAI-compatible)
# Start server: docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:v0.2.2
# Voices: af_heart, af_sarah, af_bella, am_adam, am_michael, bf_emma, bm_george
# Falls back to browser TTS automatically if not running.
# ──────────────────────────────────────────────────────────────────────────────
KOKORO_URL=http://localhost:8880
KOKORO_VOICE=af_sarah
KOKORO_SPEED=1.0
KOKORO_FORMAT=mp3
KOKORO_TIMEOUT=15000
